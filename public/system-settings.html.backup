        function restoreBackup(id) {
            const confirmed = confirm(`Restore Backup #${id}?\n\nWarning: This will overwrite all current data with the selected backup.\n\nThis action cannot be undone!\n\nProceed?`);
            if (confirmed) {
                alert(`Restoring backup #${id}...\n\nThis may take 5-10 minutes.\nSystem will be unavailable during restore.`);
            }
        }

        function downloadBackup(id) {
            alert(`Downloading backup #${id}...\n\nFile will be downloaded to your computer.\nFormat: .tar.gz\nSize: ~245 MB`);
        }

        function deleteBackup(id) {
            const confirmed = confirm(`Delete Backup #${id}?\n\nThis action cannot be undone!\n\nProceed?`);
            if (confirmed) {
                alert(`Backup #${id} deleted successfully.`);
            }
        }

        function exportReport(format) {
            // Get all data from localStorage
            const allData = {
                employees: JSON.parse(localStorage.getItem('gghr_fresh_employees') || '[]'),
                attendance: JSON.parse(localStorage.getItem('gghr_fresh_attendanceData') || '[]'),
                leaves: JSON.parse(localStorage.getItem('gghr_fresh_leaveRequests') || '[]'),
                dailyReports: JSON.parse(localStorage.getItem('gghr_fresh_dailyReports') || '[]'),
                messages: JSON.parse(localStorage.getItem('gghr_fresh_messages') || '[]'),
                emails: JSON.parse(localStorage.getItem('gghr_fresh_emails') || '[]'),
                documents: JSON.parse(localStorage.getItem('gghr_fresh_documents') || '[]')
            };
            
            const exportDate = new Date().toISOString().split('T')[0];
            
            if (format === 'csv') {
                // Export as CSV
                let csvContent = 'Data Type,Count,Last Updated\n';
                csvContent += `Employees,${allData.employees.length},${exportDate}\n`;
                csvContent += `Attendance Records,${allData.attendance.length},${exportDate}\n`;
                csvContent += `Leave Requests,${allData.leaves.length},${exportDate}\n`;
                csvContent += `Daily Reports,${allData.dailyReports.length},${exportDate}\n`;
                csvContent += `Messages,${allData.messages.length},${exportDate}\n`;
                csvContent += `Emails,${allData.emails.length},${exportDate}\n`;
                csvContent += `Documents,${allData.documents.length},${exportDate}\n`;
                
                const blob = new Blob([csvContent], { type: 'text/csv' });
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = `global-guidance-export-${exportDate}.csv`;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(url);
                
                alert('✅ Data Exported Successfully!\n\nFormat: CSV\nFilename: global-guidance-export-' + exportDate + '.csv\n\nThe file has been downloaded.');
            } else if (format === 'json') {
                // Export as JSON
                const jsonStr = JSON.stringify(allData, null, 2);
                const blob = new Blob([jsonStr], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = `global-guidance-export-${exportDate}.json`;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(url);
                
                alert('✅ Data Exported Successfully!\n\nFormat: JSON\nFilename: global-guidance-export-' + exportDate + '.json\n\nThe file has been downloaded.');
            } else if (format === 'excel') {
                alert('Excel export requires additional libraries.\n\nPlease use CSV format for now, which can be opened in Excel.\n\nClick "Export to CSV" to proceed.');
            } else {
                alert(`Export to ${format.toUpperCase()}\n\nSelect reports to export:\n- Applications & Visa\n- Finance & Commission\n- All Data\n\nClick OK to proceed with export.`);
            }
        }

