                                        <p class="text-xs text-gray-600">Sync data with Google Sheets</p>
                                    </div>
                                </div>
                                <button onclick="openGoogleSheetsConfig()" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">
                                    <i class="fas fa-cog mr-2"></i>Configure
                                </button>
                            </div>
                            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                                <div class="flex items-center space-x-3">
                                    <i class="fab fa-slack text-2xl text-purple-600"></i>
                                    <div>
                                        <p class="text-sm font-medium text-gray-800">Slack Integration</p>
                                        <p class="text-xs text-gray-600">Send notifications to Slack</p>
                                    </div>
                                </div>
                                <button onclick="showComingSoon('Slack')" class="px-4 py-2 bg-gray-400 text-white text-sm rounded-lg hover:bg-gray-500">
                                    <i class="fas fa-cog mr-2"></i>Configure
                                </button>
                            </div>
                            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                                <div class="flex items-center space-x-3">
                                    <i class="fab fa-whatsapp text-2xl text-green-600"></i>
