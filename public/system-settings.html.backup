                                <label class="block text-sm font-medium text-gray-700 mb-2">System Version</label>
                                <input type="text" value="${SYSTEM_SETTINGS.system.version}" readonly class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50" disabled>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Environment</label>
