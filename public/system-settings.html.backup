                                <i class="fas fa-database text-2xl text-orange-600 mb-2"></i>
                                <p class="text-sm font-medium text-gray-800">Clear Database Cache</p>
                                <p class="text-xs text-gray-600">Remove query cache</p>
                            </button>
                            <button onclick="clearCache('static')" class="p-4 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 text-left">
                                <i class="fas fa-file text-2xl text-blue-600 mb-2"></i>
                                <p class="text-sm font-medium text-gray-800">Clear Static Cache</p>
                                <p class="text-xs text-gray-600">Remove asset cache</p>
                            </button>
                        </div>
                    </div>

                    <!-- Mobile Optimization -->
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Mobile Optimization</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
