<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Settings & Administration - Global Guidance</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body.in-iframe .top-nav { display: none; }
        .settings-card { transition: all 0.3s ease; }
        .settings-card:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
        .status-indicator { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
        .status-active { background-color: #10b981; }
        .status-inactive { background-color: #ef4444; }
        .status-warning { background-color: #f59e0b; }
        .progress-bar { height: 8px; background-color: #e5e7eb; border-radius: 4px; overflow: hidden; }
        .progress-fill { height: 100%; background-color: #3b82f6; transition: width 0.3s ease; }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Top Navigation -->
    <nav class="top-nav bg-white shadow-sm border-b border-gray-200 px-6 py-4">
        <div class="flex items-center justify-between">
            <h1 class="text-2xl font-bold text-gray-800">
                <i class="fas fa-cog text-blue-600 mr-2"></i>
                System Settings & Administration
            </h1>
            <div class="flex items-center space-x-4">
                <span class="text-sm text-gray-600" id="lastUpdate">Last updated: Just now</span>
                <button onclick="saveAllSettings()" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                    <i class="fas fa-save mr-2"></i>Save All Changes
                </button>
            </div>
        </div>
    </nav>

    <div class="container mx-auto px-4 py-6 max-w-7xl">
        <!-- Module Navigation Tabs -->
        <div class="bg-white rounded-lg shadow-sm mb-6 overflow-hidden">
            <div class="flex flex-wrap border-b border-gray-200">
                <button onclick="switchModule('overview')" id="tab-overview" class="px-6 py-4 font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-50 border-b-2 border-transparent focus:outline-none module-tab">
                    <i class="fas fa-tachometer-alt mr-2"></i>Overview
                </button>
                <button onclick="switchModule('data')" id="tab-data" class="px-6 py-4 font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-50 border-b-2 border-transparent focus:outline-none module-tab">
                    <i class="fas fa-database mr-2"></i>Data Management
                </button>
                <button onclick="switchModule('reports')" id="tab-reports" class="px-6 py-4 font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-50 border-b-2 border-transparent focus:outline-none module-tab">
                    <i class="fas fa-file-export mr-2"></i>Reporting & Export
                </button>
                <button onclick="switchModule('company')" id="tab-company" class="px-6 py-4 font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-50 border-b-2 border-transparent focus:outline-none module-tab">
                    <i class="fas fa-building mr-2"></i>Company Settings
                </button>
                <button onclick="switchModule('system')" id="tab-system" class="px-6 py-4 font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-50 border-b-2 border-transparent focus:outline-none module-tab">
                    <i class="fas fa-server mr-2"></i>System Config
                </button>
                <button onclick="switchModule('security')" id="tab-security" class="px-6 py-4 font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-50 border-b-2 border-transparent focus:outline-none module-tab">
                    <i class="fas fa-shield-alt mr-2"></i>Security
                </button>
                <button onclick="switchModule('performance')" id="tab-performance" class="px-6 py-4 font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-50 border-b-2 border-transparent focus:outline-none module-tab">
                    <i class="fas fa-rocket mr-2"></i>Performance
                </button>
            </div>
        </div>

        <!-- Module Container -->
        <div id="moduleContainer"></div>
    </div>

    <!-- Google Sheets Configuration Modal -->
    <div id="googleSheetsModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
            <!-- Modal Header -->
            <div class="bg-gradient-to-r from-blue-600 to-blue-700 text-white p-6 rounded-t-xl">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <i class="fab fa-google text-3xl"></i>
                        <div>
                            <h3 class="text-xl font-bold">Google Sheets Integration</h3>
                            <p class="text-sm text-blue-100">Configure connection to Umair Staff Portal</p>
                        </div>
                    </div>
                    <button onclick="closeGoogleSheetsConfig()" class="text-white hover:text-gray-200 transition">
                        <i class="fas fa-times text-2xl"></i>
                    </button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="p-6 space-y-6">
                <!-- Current Status -->
                <div id="configStatus" class="p-4 rounded-lg border">
                    <!-- Will be populated dynamically -->
                </div>

                <!-- Google Sheet URL -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-table mr-2 text-blue-600"></i>Google Sheet URL
                    </label>
                    <input 
                        type="url" 
                        id="googleSheetUrl"
                        readonly
                        value="https://docs.google.com/spreadsheets/d/1bTBIXZAlK0Z-EgIxAOWviY_-oETih07KtMOWgFmL9ew/edit"
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-600 focus:ring-2 focus:ring-blue-500"
                    />
                    <p class="mt-2 text-xs text-gray-500">
                        <i class="fas fa-info-circle mr-1"></i>
                        This is the Google Sheet used for Umair Staff Portal data
                    </p>
                </div>

                <!-- Apps Script Deployment URL -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-code mr-2 text-green-600"></i>Apps Script Deployment URL
                    </label>
                    <input 
                        type="url" 
                        id="appsScriptUrl"
                        placeholder="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                    />
                    <p class="mt-2 text-xs text-gray-500">
                        <i class="fas fa-info-circle mr-1"></i>
                        Get this URL after deploying the Apps Script as a Web App
                    </p>
                </div>

                <!-- Setup Instructions -->
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <h4 class="font-semibold text-blue-900 mb-3 flex items-center">
                        <i class="fas fa-book mr-2"></i>Setup Instructions
                    </h4>
                    <ol class="space-y-2 text-sm text-blue-800">
                        <li class="flex items-start">
                            <span class="font-semibold mr-2">1.</span>
                            <span>Open the Google Sheet above</span>
                        </li>
                        <li class="flex items-start">
                            <span class="font-semibold mr-2">2.</span>
                            <span>Go to <strong>Extensions</strong> → <strong>Apps Script</strong></span>
                        </li>
                        <li class="flex items-start">
                            <span class="font-semibold mr-2">3.</span>
                            <span>Copy the code from <code class="bg-blue-100 px-1 rounded">/home/user/webapp/GOOGLE_APPS_SCRIPT_SETUP.md</code></span>
                        </li>
                        <li class="flex items-start">
                            <span class="font-semibold mr-2">4.</span>
                            <span>Deploy as <strong>Web App</strong> (Execute as: Me, Access: Anyone)</span>
                        </li>
                        <li class="flex items-start">
                            <span class="font-semibold mr-2">5.</span>
                            <span>Copy the deployment URL and paste it above</span>
                        </li>
                        <li class="flex items-start">
                            <span class="font-semibold mr-2">6.</span>
                            <span>Click <strong>Test Connection</strong> below</span>
                        </li>
                    </ol>
                </div>

                <!-- Test Result -->
                <div id="testResult" class="hidden p-4 rounded-lg">
                    <!-- Will show test results -->
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center justify-between pt-4 border-t">
                    <button 
                        onclick="testConnection()" 
                        class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 font-medium transition flex items-center"
                    >
                        <i class="fas fa-plug mr-2"></i>Test Connection
                    </button>
                    <div class="space-x-3">
                        <button 
                            onclick="closeGoogleSheetsConfig()" 
                            class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 font-medium transition"
                        >
                            Cancel
                        </button>
                        <button 
                            onclick="saveGoogleSheetsConfig()" 
                            class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition"
                        >
                            <i class="fas fa-save mr-2"></i>Save Configuration
                        </button>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                    <h4 class="font-semibold text-gray-700 mb-2 flex items-center">
                        <i class="fas fa-link mr-2"></i>Quick Links
                    </h4>
                    <div class="space-y-2 text-sm">
                        <a href="https://3000-i1or73f6i7zoopcazy4yn-2b54fc91.sandbox.novita.ai/umair-portal" target="_blank" class="flex items-center text-blue-600 hover:text-blue-700">
                            <i class="fas fa-external-link-alt mr-2"></i>Open Umair Staff Portal
                        </a>
                        <a href="https://docs.google.com/spreadsheets/d/1bTBIXZAlK0Z-EgIxAOWviY_-oETih07KtMOWgFmL9ew/edit" target="_blank" class="flex items-center text-blue-600 hover:text-blue-700">
                            <i class="fas fa-external-link-alt mr-2"></i>Open Google Sheet
                        </a>
                        <button onclick="showSetupGuide()" class="flex items-center text-blue-600 hover:text-blue-700 w-full text-left">
                            <i class="fas fa-book-open mr-2"></i>View Full Setup Guide
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Check if in iframe
        const isInIframe = window.self !== window.top;
        if (isInIframe) document.body.classList.add('in-iframe');

        // System Settings Data
        const SYSTEM_SETTINGS = {
            company: {
                name: 'Global Guidance Education Consultancy',
                email: 'info@globalguidance.lk',
                phone: '+94 11 234 5678',
                address: 'Colombo, Sri Lanka',
                website: 'www.globalguidance.lk',
                logo: '/static/logo.png',
                timezone: 'Asia/Colombo',
                currency: 'LKR',
                language: 'English'
            },
            system: {
                version: '1.0.0',
                environment: 'Production',
                database: 'D1 (SQLite)',
                storage: 'Cloudflare R2',
                cdn: 'Cloudflare CDN',
                uptime: '99.9%',
                lastBackup: '2026-02-08 01:00 AM',
                nextBackup: '2026-02-09 01:00 AM'
            },
            security: {
                sslEnabled: true,
                encryptionEnabled: true,
                twoFactorAuth: false,
                sessionTimeout: 30,
                passwordPolicy: 'Strong',
                auditLogging: true,
                gdprCompliant: true,
                lastSecurityAudit: '2026-02-01'
            },
            performance: {
                caching: true,
                compression: true,
                minification: true,
                lazyLoading: true,
                cdnEnabled: true,
                avgPageLoad: '450ms',
                avgApiResponse: '85ms',
                cacheHitRate: '92%'
            },
            notifications: {
                emailEnabled: true,
                smsEnabled: false,
                pushEnabled: true,
                whatsappEnabled: false,
                slackEnabled: false
            },
            backups: [
                { id: 1, date: '2026-02-08 01:00 AM', size: '245 MB', status: 'Success', type: 'Automatic' },
                { id: 2, date: '2026-02-07 01:00 AM', size: '242 MB', status: 'Success', type: 'Automatic' },
                { id: 3, date: '2026-02-06 01:00 AM', size: '238 MB', status: 'Success', type: 'Automatic' },
                { id: 4, date: '2026-02-05 12:30 PM', size: '236 MB', status: 'Success', type: 'Manual' },
                { id: 5, date: '2026-02-05 01:00 AM', size: '235 MB', status: 'Success', type: 'Automatic' }
            ],
            exports: [
                { id: 1, name: 'Applications Report', format: 'Excel', date: '2026-02-08', size: '1.2 MB', status: 'Completed' },
                { id: 2, name: 'Finance Summary', format: 'PDF', date: '2026-02-07', size: '345 KB', status: 'Completed' },
                { id: 3, name: 'Student Data', format: 'CSV', date: '2026-02-06', size: '2.1 MB', status: 'Completed' },
                { id: 4, name: 'Commission Report', format: 'Excel', date: '2026-02-05', size: '890 KB', status: 'Completed' }
            ]
        };

        // Current module state
        let currentModule = 'overview';

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            switchModule('overview');
        });

        // Switch Module Function
        function switchModule(module) {
            currentModule = module;
            
            // Update tab styling
            document.querySelectorAll('.module-tab').forEach(tab => {
                tab.classList.remove('border-blue-600', 'text-blue-600');
                tab.classList.add('border-transparent');
            });
            document.getElementById(`tab-${module}`).classList.add('border-blue-600', 'text-blue-600');
            document.getElementById(`tab-${module}`).classList.remove('border-transparent');

            // Render module content
            const container = document.getElementById('moduleContainer');
            switch(module) {
                case 'overview':
                    container.innerHTML = renderOverview();
                    break;
                case 'data':
                    container.innerHTML = renderDataManagement();
                    break;
                case 'reports':
                    container.innerHTML = renderReporting();
                    break;
                case 'company':
                    container.innerHTML = renderCompanySettings();
                    break;
                case 'system':
                    container.innerHTML = renderSystemConfig();
                    break;
                case 'security':
                    container.innerHTML = renderSecurity();
                    break;
                case 'performance':
                    container.innerHTML = renderPerformance();
                    break;
            }
        }

        // Overview Module
        function renderOverview() {
            return `
                <div class="space-y-6">
                    <!-- Daily Backup Information Banner -->
                    <div class="bg-gradient-to-r from-blue-50 to-blue-100 border-l-4 border-blue-600 rounded-lg p-6 shadow-sm">
                        <div class="flex items-start">
                            <div class="flex-shrink-0">
                                <i class="fas fa-info-circle text-blue-600 text-2xl mt-1"></i>
                            </div>
                            <div class="ml-4 flex-1">
                                <h3 class="text-lg font-bold text-blue-900 mb-2">
                                    <i class="fas fa-clock mr-2"></i>Automatic Daily Backup System Active
                                </h3>
                                <div class="text-sm text-blue-800 space-y-2">
                                    <p class="font-semibold">
                                        📊 Your system automatically backs up all data daily at 6:00 PM
                                    </p>
                                    <div class="bg-white/60 rounded p-3 mt-2">
                                        <p class="font-semibold text-blue-900 mb-2">Backed up data includes:</p>
                                        <ul class="list-disc list-inside space-y-1 ml-2">
                                            <li><strong>Attendance Records</strong> - Check-in/Check-out times, status, locations</li>
                                            <li><strong>Daily Tasks & Submissions</strong> - All to-do items and task reports</li>
                                            <li><strong>Daily Reports</strong> - Morning and evening reports from all staff</li>
                                            <li><strong>Leave Requests</strong> - All leave applications and approvals</li>
                                            <li><strong>Communications</strong> - Internal messages and emails</li>
                                            <li><strong>Documents</strong> - Document library records</li>
                                            <li><strong>Summary Statistics</strong> - Daily operational metrics</li>
                                        </ul>
                                    </div>
                                    <div class="bg-yellow-50 border border-yellow-300 rounded p-3 mt-3">
                                        <p class="font-semibold text-yellow-900 mb-1">
                                            <i class="fas fa-download mr-2"></i>Manual Backup Available
                                        </p>
                                        <p class="text-yellow-800">
                                            You can also download a backup anytime from the Dashboard or by clicking "Create Backup" below. 
                                            The file will be saved as an Excel workbook with separate sheets for each data type.
                                        </p>
                                    </div>
                                    <p class="text-xs text-blue-700 mt-2">
                                        <i class="fas fa-shield-alt mr-1"></i>
                                        Last automatic backup: <span id="lastBackupTime">Checking...</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- System Health Status -->
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">System Health Status</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                            <div class="bg-green-50 rounded-lg p-4 border border-green-200">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-sm font-medium text-green-800">System Status</span>
                                    <span class="status-indicator status-active"></span>
                                </div>
                                <p class="text-2xl font-bold text-green-700">Online</p>
                                <p class="text-xs text-green-600 mt-1">Uptime: 99.9%</p>
                            </div>
                            <div class="bg-blue-50 rounded-lg p-4 border border-blue-200">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-sm font-medium text-blue-800">Performance</span>
                                    <span class="status-indicator status-active"></span>
                                </div>
                                <p class="text-2xl font-bold text-blue-700">Excellent</p>
                                <p class="text-xs text-blue-600 mt-1">Load: 450ms avg</p>
                            </div>
                            <div class="bg-purple-50 rounded-lg p-4 border border-purple-200">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-sm font-medium text-purple-800">Security</span>
                                    <span class="status-indicator status-active"></span>
                                </div>
                                <p class="text-2xl font-bold text-purple-700">Protected</p>
                                <p class="text-xs text-purple-600 mt-1">SSL + Encryption</p>
                            </div>
                            <div class="bg-orange-50 rounded-lg p-4 border border-orange-200">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-sm font-medium text-orange-800">Backups</span>
                                    <span class="status-indicator status-active"></span>
                                </div>
                                <p class="text-2xl font-bold text-orange-700">Active</p>
                                <p class="text-xs text-orange-600 mt-1">Last: 1 hour ago</p>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Quick Actions</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                            <button onclick="performAction('backup')" class="settings-card bg-white border-2 border-gray-200 rounded-lg p-6 text-center hover:border-blue-500 cursor-pointer">
                                <i class="fas fa-cloud-upload-alt text-4xl text-blue-600 mb-3"></i>
                                <h4 class="text-sm font-semibold text-gray-800">Create Backup</h4>
                                <p class="text-xs text-gray-600 mt-1">Manual backup now</p>
                            </button>
                            <button onclick="performAction('export')" class="settings-card bg-white border-2 border-gray-200 rounded-lg p-6 text-center hover:border-blue-500 cursor-pointer">
                                <i class="fas fa-file-export text-4xl text-green-600 mb-3"></i>
                                <h4 class="text-sm font-semibold text-gray-800">Export Data</h4>
                                <p class="text-xs text-gray-600 mt-1">Export to Excel/CSV</p>
                            </button>
                            <button onclick="performAction('cleanup')" class="settings-card bg-white border-2 border-gray-200 rounded-lg p-6 text-center hover:border-blue-500 cursor-pointer">
                                <i class="fas fa-broom text-4xl text-orange-600 mb-3"></i>
                                <h4 class="text-sm font-semibold text-gray-800">System Cleanup</h4>
                                <p class="text-xs text-gray-600 mt-1">Clear cache & logs</p>
                            </button>
                            <button onclick="performAction('audit')" class="settings-card bg-white border-2 border-gray-200 rounded-lg p-6 text-center hover:border-blue-500 cursor-pointer">
                                <i class="fas fa-clipboard-check text-4xl text-purple-600 mb-3"></i>
                                <h4 class="text-sm font-semibold text-gray-800">Security Audit</h4>
                                <p class="text-xs text-gray-600 mt-1">Run security scan</p>
                            </button>
                        </div>
                    </div>

                    <!-- System Information -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="bg-white rounded-lg shadow-sm p-6">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">System Information</h3>
                            <div class="space-y-3">
                                <div class="flex justify-between items-center py-2 border-b border-gray-100">
                                    <span class="text-sm text-gray-600">Version</span>
                                    <span class="text-sm font-medium text-gray-800">${SYSTEM_SETTINGS.system.version}</span>
                                </div>
                                <div class="flex justify-between items-center py-2 border-b border-gray-100">
                                    <span class="text-sm text-gray-600">Environment</span>
                                    <span class="px-2 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded">${SYSTEM_SETTINGS.system.environment}</span>
                                </div>
                                <div class="flex justify-between items-center py-2 border-b border-gray-100">
                                    <span class="text-sm text-gray-600">Database</span>
                                    <span class="text-sm font-medium text-gray-800">${SYSTEM_SETTINGS.system.database}</span>
                                </div>
                                <div class="flex justify-between items-center py-2 border-b border-gray-100">
                                    <span class="text-sm text-gray-600">Storage</span>
                                    <span class="text-sm font-medium text-gray-800">${SYSTEM_SETTINGS.system.storage}</span>
                                </div>
                                <div class="flex justify-between items-center py-2">
                                    <span class="text-sm text-gray-600">Uptime</span>
                                    <span class="text-sm font-medium text-green-600">${SYSTEM_SETTINGS.system.uptime}</span>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white rounded-lg shadow-sm p-6">
                            <h3 class="text-lg font-semibold text-gray-800 mb-4">Recent Activity</h3>
                            <div class="space-y-3">
                                <div class="flex items-start space-x-3 pb-3 border-b border-gray-100">
                                    <i class="fas fa-cloud-upload-alt text-blue-600 mt-1"></i>
                                    <div class="flex-1">
                                        <p class="text-sm text-gray-800 font-medium">Automatic Backup Completed</p>
                                        <p class="text-xs text-gray-600">1 hour ago • 245 MB</p>
                                    </div>
                                </div>
                                <div class="flex items-start space-x-3 pb-3 border-b border-gray-100">
                                    <i class="fas fa-file-export text-green-600 mt-1"></i>
                                    <div class="flex-1">
                                        <p class="text-sm text-gray-800 font-medium">Applications Report Exported</p>
                                        <p class="text-xs text-gray-600">3 hours ago • Excel format</p>
                                    </div>
                                </div>
                                <div class="flex items-start space-x-3 pb-3 border-b border-gray-100">
                                    <i class="fas fa-shield-alt text-purple-600 mt-1"></i>
                                    <div class="flex-1">
                                        <p class="text-sm text-gray-800 font-medium">Security Scan Completed</p>
                                        <p class="text-xs text-gray-600">5 hours ago • No issues found</p>
                                    </div>
                                </div>
                                <div class="flex items-start space-x-3">
                                    <i class="fas fa-broom text-orange-600 mt-1"></i>
                                    <div class="flex-1">
                                        <p class="text-sm text-gray-800 font-medium">System Cleanup Completed</p>
                                        <p class="text-xs text-gray-600">1 day ago • 125 MB freed</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        // Data Management Module
        function renderDataManagement() {
            return `
                <div class="space-y-6">
                    <!-- Data Operations -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <div class="settings-card bg-white rounded-lg shadow-sm p-6 border-l-4 border-blue-500">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-lg font-semibold text-gray-800">Data Export</h3>
                                <i class="fas fa-file-export text-2xl text-blue-600"></i>
                            </div>
                            <p class="text-sm text-gray-600 mb-4">Export data to CSV, Excel, PDF formats</p>
                            <button onclick="openExportModal()" class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                                <i class="fas fa-download mr-2"></i>Export Data
                            </button>
                        </div>

                        <div class="settings-card bg-white rounded-lg shadow-sm p-6 border-l-4 border-green-500">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-lg font-semibold text-gray-800">Data Import</h3>
                                <i class="fas fa-file-import text-2xl text-green-600"></i>
                            </div>
                            <p class="text-sm text-gray-600 mb-4">Import data from external sources</p>
                            <button onclick="openImportModal()" class="w-full px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                                <i class="fas fa-upload mr-2"></i>Import Data
                            </button>
                        </div>

                        <div class="settings-card bg-white rounded-lg shadow-sm p-6 border-l-4 border-purple-500">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-lg font-semibold text-gray-800">Data Backup</h3>
                                <i class="fas fa-cloud-upload-alt text-2xl text-purple-600"></i>
                            </div>
                            <p class="text-sm text-gray-600 mb-4">Create manual backup now</p>
                            <button onclick="createBackup()" class="w-full px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700">
                                <i class="fas fa-save mr-2"></i>Create Backup
                            </button>
                        </div>

                        <div class="settings-card bg-white rounded-lg shadow-sm p-6 border-l-4 border-orange-500">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-lg font-semibold text-gray-800">Data Restore</h3>
                                <i class="fas fa-cloud-download-alt text-2xl text-orange-600"></i>
                            </div>
                            <p class="text-sm text-gray-600 mb-4">Restore from previous backups</p>
                            <button onclick="openRestoreModal()" class="w-full px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700">
                                <i class="fas fa-history mr-2"></i>Restore Data
                            </button>
                        </div>

                        <div class="settings-card bg-white rounded-lg shadow-sm p-6 border-l-4 border-red-500">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-lg font-semibold text-gray-800">Data Cleanup</h3>
                                <i class="fas fa-broom text-2xl text-red-600"></i>
                            </div>
                            <p class="text-sm text-gray-600 mb-4">Clean up cache, logs, temp files</p>
                            <button onclick="performCleanup()" class="w-full px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">
                                <i class="fas fa-trash mr-2"></i>Clean Up
                            </button>
                        </div>

                        <div class="settings-card bg-white rounded-lg shadow-sm p-6 border-l-4 border-teal-500">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-lg font-semibold text-gray-800">Data Archive</h3>
                                <i class="fas fa-archive text-2xl text-teal-600"></i>
                            </div>
                            <p class="text-sm text-gray-600 mb-4">Archive old data for storage</p>
                            <button onclick="archiveData()" class="w-full px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700">
                                <i class="fas fa-box mr-2"></i>Archive Data
                            </button>
                        </div>
                    </div>

                    <!-- Backup History -->
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-semibold text-gray-800">Backup History</h3>
                            <button onclick="createBackup()" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">
                                <i class="fas fa-plus mr-2"></i>New Backup
                            </button>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date & Time</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Size</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200">
                                    ${SYSTEM_SETTINGS.backups.map(b => `
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-6 py-4 text-sm text-gray-900">${b.date}</td>
                                            <td class="px-6 py-4 text-sm text-gray-600">${b.size}</td>
                                            <td class="px-6 py-4">
                                                <span class="px-2 py-1 text-xs font-semibold rounded ${b.type === 'Automatic' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800'}">
                                                    ${b.type}
                                                </span>
                                            </td>
                                            <td class="px-6 py-4">
                                                <span class="px-2 py-1 text-xs font-semibold rounded bg-green-100 text-green-800">
                                                    <i class="fas fa-check-circle mr-1"></i>${b.status}
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-sm">
                                                <button onclick="restoreBackup(${b.id})" class="text-blue-600 hover:text-blue-800 mr-3" title="Restore">
                                                    <i class="fas fa-undo"></i>
                                                </button>
                                                <button onclick="downloadBackup(${b.id})" class="text-green-600 hover:text-green-800 mr-3" title="Download">
                                                    <i class="fas fa-download"></i>
                                                </button>
                                                <button onclick="deleteBackup(${b.id})" class="text-red-600 hover:text-red-800" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Automatic Backup Settings -->
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Automatic Backup Settings</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Backup Frequency</label>
                                <select class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                    <option value="daily" selected>Daily at 1:00 AM</option>
                                    <option value="hourly">Every Hour</option>
                                    <option value="weekly">Weekly</option>
                                    <option value="monthly">Monthly</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Retention Period</label>
                                <select class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                    <option value="7">Keep 7 days</option>
                                    <option value="30" selected>Keep 30 days</option>
                                    <option value="90">Keep 90 days</option>
                                    <option value="365">Keep 1 year</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        // Reporting & Export Module
        function renderReporting() {
            return `
                <div class="space-y-6">
                    <!-- Export Formats -->
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Export Reports</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                            <button onclick="exportReport('pdf')" class="settings-card bg-white border-2 border-gray-200 rounded-lg p-6 text-center hover:border-red-500 cursor-pointer">
                                <i class="fas fa-file-pdf text-4xl text-red-600 mb-3"></i>
                                <h4 class="text-sm font-semibold text-gray-800">Export to PDF</h4>
                                <p class="text-xs text-gray-600 mt-1">Formatted reports</p>
                            </button>
                            <button onclick="exportReport('excel')" class="settings-card bg-white border-2 border-gray-200 rounded-lg p-6 text-center hover:border-green-500 cursor-pointer">
                                <i class="fas fa-file-excel text-4xl text-green-600 mb-3"></i>
                                <h4 class="text-sm font-semibold text-gray-800">Export to Excel</h4>
                                <p class="text-xs text-gray-600 mt-1">Spreadsheet format</p>
                            </button>
                            <button onclick="exportReport('csv')" class="settings-card bg-white border-2 border-gray-200 rounded-lg p-6 text-center hover:border-blue-500 cursor-pointer">
                                <i class="fas fa-file-csv text-4xl text-blue-600 mb-3"></i>
                                <h4 class="text-sm font-semibold text-gray-800">Export to CSV</h4>
                                <p class="text-xs text-gray-600 mt-1">Comma separated</p>
                            </button>
                            <button onclick="exportReport('json')" class="settings-card bg-white border-2 border-gray-200 rounded-lg p-6 text-center hover:border-purple-500 cursor-pointer">
                                <i class="fas fa-file-code text-4xl text-purple-600 mb-3"></i>
                                <h4 class="text-sm font-semibold text-gray-800">Export to JSON</h4>
                                <p class="text-xs text-gray-600 mt-1">Raw data format</p>
                            </button>
                        </div>
                    </div>

                    <!-- Report Selection -->
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Select Report to Export</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="border-2 border-gray-200 rounded-lg p-4 hover:border-blue-500 cursor-pointer">
                                <div class="flex items-center space-x-3">
                                    <input type="checkbox" id="report-applications" class="w-4 h-4 text-blue-600">
                                    <label for="report-applications" class="flex-1 cursor-pointer">
                                        <p class="text-sm font-medium text-gray-800">Applications & Visa Report</p>
                                        <p class="text-xs text-gray-600">48 applications • All fields</p>
                                    </label>
                                </div>
                            </div>
                            <div class="border-2 border-gray-200 rounded-lg p-4 hover:border-blue-500 cursor-pointer">
                                <div class="flex items-center space-x-3">
                                    <input type="checkbox" id="report-finance" class="w-4 h-4 text-blue-600">
                                    <label for="report-finance" class="flex-1 cursor-pointer">
                                        <p class="text-sm font-medium text-gray-800">Finance & Commission Report</p>
                                        <p class="text-xs text-gray-600">All financial data</p>
                                    </label>
                                </div>
                            </div>
                            <div class="border-2 border-gray-200 rounded-lg p-4 hover:border-blue-500 cursor-pointer">
                                <div class="flex items-center space-x-3">
                                    <input type="checkbox" id="report-students" class="w-4 h-4 text-blue-600">
                                    <label for="report-students" class="flex-1 cursor-pointer">
                                        <p class="text-sm font-medium text-gray-800">Student Database</p>
                                        <p class="text-xs text-gray-600">All student records</p>
                                    </label>
                                </div>
                            </div>
                            <div class="border-2 border-gray-200 rounded-lg p-4 hover:border-blue-500 cursor-pointer">
                                <div class="flex items-center space-x-3">
                                    <input type="checkbox" id="report-analytics" class="w-4 h-4 text-blue-600">
                                    <label for="report-analytics" class="flex-1 cursor-pointer">
                                        <p class="text-sm font-medium text-gray-800">Analytics & Metrics</p>
                                        <p class="text-xs text-gray-600">Dashboard metrics</p>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 flex space-x-3">
                            <button onclick="exportSelected()" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                                <i class="fas fa-download mr-2"></i>Export Selected
                            </button>
                            <button onclick="scheduleExport()" class="px-6 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700">
                                <i class="fas fa-clock mr-2"></i>Schedule Export
                            </button>
                        </div>
                    </div>

                    <!-- Export History -->
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Recent Exports</h3>
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Report Name</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Format</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Size</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200">
                                    ${SYSTEM_SETTINGS.exports.map(e => `
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-6 py-4 text-sm font-medium text-gray-900">${e.name}</td>
                                            <td class="px-6 py-4">
                                                <span class="px-2 py-1 text-xs font-semibold rounded ${
                                                    e.format === 'PDF' ? 'bg-red-100 text-red-800' :
                                                    e.format === 'Excel' ? 'bg-green-100 text-green-800' :
                                                    e.format === 'CSV' ? 'bg-blue-100 text-blue-800' :
                                                    'bg-purple-100 text-purple-800'
                                                }">
                                                    ${e.format}
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-sm text-gray-600">${e.date}</td>
                                            <td class="px-6 py-4 text-sm text-gray-600">${e.size}</td>
                                            <td class="px-6 py-4">
                                                <span class="px-2 py-1 text-xs font-semibold rounded bg-green-100 text-green-800">
                                                    <i class="fas fa-check-circle mr-1"></i>${e.status}
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-sm">
                                                <button onclick="downloadExport(${e.id})" class="text-blue-600 hover:text-blue-800 mr-3" title="Download">
                                                    <i class="fas fa-download"></i>
                                                </button>
                                                <button onclick="emailExport(${e.id})" class="text-green-600 hover:text-green-800" title="Email">
                                                    <i class="fas fa-envelope"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Scheduled Exports -->
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-4">Scheduled Exports</h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between p-4 bg-blue-50 rounded-lg">
                                <div class="flex items-center space-x-3">
                                    <i class="fas fa-calendar-alt text-blue-600"></i>
                                    <div>
                                        <p class="text-sm font-medium text-gray-800">Weekly Applications Report</p>
                                        <p class="text-xs text-gray-600">Every Monday at 9:00 AM • Excel format</p>
                                    </div>
                                </div>
                                <button class="text-red-600 hover:text-red-800">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <div class="flex items-center justify-between p-4 bg-green-50 rounded-lg">
                                <div class="flex items-center space-x-3">
                                    <i class="fas fa-calendar-alt text-green-600"></i>
                                    <div>
                                        <p class="text-sm font-medium text-gray-800">Monthly Finance Report</p>
                                        <p class="text-xs text-gray-600">1st of every month • PDF format</p>
                                    </div>
                                </div>
                                <button class="text-red-600 hover:text-red-800">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        // Company Settings Module
        function renderCompanySettings() {
            return `
                <div class="space-y-6">
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-6">Company Information</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Company Name</label>
                                <input type="text" value="${SYSTEM_SETTINGS.company.name}" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                                <input type="email" value="${SYSTEM_SETTINGS.company.email}" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Phone Number</label>
                                <input type="tel" value="${SYSTEM_SETTINGS.company.phone}" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Website</label>
                                <input type="url" value="${SYSTEM_SETTINGS.company.website}" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div class="md:col-span-2">
                                <label class="block text-sm font-medium text-gray-700 mb-2">Address</label>
                                <textarea rows="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">${SYSTEM_SETTINGS.company.address}</textarea>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Timezone</label>
                                <select class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                    <option value="Asia/Colombo" selected>Asia/Colombo (UTC+5:30)</option>
                                    <option value="Asia/Dubai">Asia/Dubai (UTC+4)</option>
                                    <option value="Europe/London">Europe/London (UTC+0)</option>
                                    <option value="America/New_York">America/New_York (UTC-5)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Currency</label>
                                <select class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                    <option value="LKR" selected>Sri Lankan Rupee (LKR)</option>
                                    <option value="USD">US Dollar (USD)</option>
                                    <option value="GBP">British Pound (GBP)</option>
                                    <option value="EUR">Euro (EUR)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Logo & Branding -->
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-6">Logo & Branding</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Company Logo</label>
                                <div class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center">
                                    <img src="/static/logo.png" alt="Logo" class="h-16 mx-auto mb-3">
                                    <button class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">
                                        <i class="fas fa-upload mr-2"></i>Upload New Logo
                                    </button>
                                    <p class="text-xs text-gray-500 mt-2">Recommended: 200x200px, PNG or SVG</p>
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Brand Colors</label>
                                <div class="space-y-3">
                                    <div>
                                        <label class="text-xs text-gray-600">Primary Color</label>
                                        <input type="color" value="#3b82f6" class="w-full h-10 rounded-lg cursor-pointer">
                                    </div>
                                    <div>
                                        <label class="text-xs text-gray-600">Secondary Color</label>
                                        <input type="color" value="#10b981" class="w-full h-10 rounded-lg cursor-pointer">
                                    </div>
                                    <div>
                                        <label class="text-xs text-gray-600">Accent Color</label>
                                        <input type="color" value="#f59e0b" class="w-full h-10 rounded-lg cursor-pointer">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Email & Notifications -->
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-6">Email & Notification Settings</h3>
                        <div class="space-y-4">
                            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                                <div>
                                    <p class="text-sm font-medium text-gray-800">Email Notifications</p>
                                    <p class="text-xs text-gray-600">Send system notifications via email</p>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" checked class="sr-only peer">
                                    <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                                </label>
                            </div>
                            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                                <div>
                                    <p class="text-sm font-medium text-gray-800">SMS Notifications</p>
                                    <p class="text-xs text-gray-600">Send notifications via SMS</p>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" class="sr-only peer">
