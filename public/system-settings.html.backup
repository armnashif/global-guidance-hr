        function saveAllSettings() {
            // Save company settings to localStorage
            const companySettings = {
                name: document.querySelector('input[type="text"]')?.value || SYSTEM_SETTINGS.company.name,
                email: document.querySelector('input[type="email"]')?.value || SYSTEM_SETTINGS.company.email,
                phone: document.querySelector('input[type="tel"]')?.value || SYSTEM_SETTINGS.company.phone,
                website: document.querySelector('input[type="url"]')?.value || SYSTEM_SETTINGS.company.website,
                address: document.querySelector('textarea')?.value || SYSTEM_SETTINGS.company.address
            };
            
            // Save to localStorage
            localStorage.setItem('gghr_company_settings', JSON.stringify(companySettings));
            
            // Update the global settings object
            Object.assign(SYSTEM_SETTINGS.company, companySettings);
            
            // Show success message
            const saveBtn = event.target;
            const originalText = saveBtn.innerHTML;
            saveBtn.innerHTML = '<i class="fas fa-check mr-2"></i>Saved!';
            saveBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
            saveBtn.classList.add('bg-green-600');
            
            setTimeout(() => {
                saveBtn.innerHTML = originalText;
                saveBtn.classList.remove('bg-green-600');
                saveBtn.classList.add('bg-blue-600', 'hover:bg-blue-700');
            }, 2000);
            
            alert('✅ Settings Saved Successfully!\n\nAll configuration changes have been saved.\n\n' + 
                  'Company Name: ' + companySettings.name + '\n' +
                  'Email: ' + companySettings.email + '\n' +
                  'Phone: ' + companySettings.phone);
        }

        function refreshData() {
            const currentTime = new Date().toLocaleTimeString();
            document.getElementById('lastUpdate').textContent = `Last updated: ${currentTime}`;
            switchModule(currentModule);
        }

        // Google Sheets Integration Functions
        function openGoogleSheetsConfig() {
            const modal = document.getElementById('googleSheetsModal');
            modal.classList.remove('hidden');
            
            // Load saved configuration
            const savedUrl = localStorage.getItem('APPS_SCRIPT_URL') || '';
            document.getElementById('appsScriptUrl').value = savedUrl;
            
            // Update status
            updateConfigStatus();
        }

        function closeGoogleSheetsConfig() {
            const modal = document.getElementById('googleSheetsModal');
            modal.classList.add('hidden');
            
            // Clear test results
            const testResult = document.getElementById('testResult');
            testResult.classList.add('hidden');
            testResult.innerHTML = '';
        }

        function updateConfigStatus() {
            const statusDiv = document.getElementById('configStatus');
            const savedUrl = localStorage.getItem('APPS_SCRIPT_URL') || '';
            
            if (!savedUrl || savedUrl.includes('YOUR_DEPLOYMENT_ID')) {
                statusDiv.className = 'p-4 rounded-lg border border-yellow-200 bg-yellow-50';
                statusDiv.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <i class="fas fa-exclamation-triangle text-yellow-600 text-xl"></i>
                        <div>
                            <p class="font-semibold text-yellow-900">Not Configured</p>
                            <p class="text-sm text-yellow-700">Apps Script deployment URL is required to enable the integration</p>
                        </div>
                    </div>
                `;
            } else {
                statusDiv.className = 'p-4 rounded-lg border border-green-200 bg-green-50';
                statusDiv.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <i class="fas fa-check-circle text-green-600 text-xl"></i>
                        <div>
                            <p class="font-semibold text-green-900">Configured</p>
                            <p class="text-sm text-green-700">Apps Script URL is set. Use "Test Connection" to verify.</p>
                        </div>
                    </div>
                `;
            }
        }

        async function testConnection() {
            const appsScriptUrl = document.getElementById('appsScriptUrl').value.trim();
            const testResult = document.getElementById('testResult');
            
            if (!appsScriptUrl) {
                testResult.className = 'p-4 rounded-lg border border-red-200 bg-red-50';
                testResult.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <i class="fas fa-times-circle text-red-600 text-xl"></i>
                        <div>
                            <p class="font-semibold text-red-900">Error</p>
                            <p class="text-sm text-red-700">Please enter the Apps Script deployment URL</p>
                        </div>
                    </div>
                `;
                testResult.classList.remove('hidden');
                return;
            }

            if (appsScriptUrl.includes('YOUR_DEPLOYMENT_ID')) {
                testResult.className = 'p-4 rounded-lg border border-red-200 bg-red-50';
                testResult.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <i class="fas fa-times-circle text-red-600 text-xl"></i>
                        <div>
                            <p class="font-semibold text-red-900">Invalid URL</p>
                            <p class="text-sm text-red-700">Please replace YOUR_DEPLOYMENT_ID with your actual deployment ID</p>
                        </div>
                    </div>
                `;
                testResult.classList.remove('hidden');
                return;
            }

            // Show loading state
            testResult.className = 'p-4 rounded-lg border border-blue-200 bg-blue-50';
            testResult.innerHTML = `
                <div class="flex items-center space-x-3">
                    <i class="fas fa-spinner fa-spin text-blue-600 text-xl"></i>
                    <div>
                        <p class="font-semibold text-blue-900">Testing Connection...</p>
                        <p class="text-sm text-blue-700">Attempting to connect to Google Sheets via Apps Script</p>
                    </div>
                </div>
            `;
            testResult.classList.remove('hidden');

            try {
                // Test the connection by trying to read Staff sheet
                const testUrl = `${appsScriptUrl}?action=read&sheet=Staff`;
                const response = await fetch(testUrl, {
                    method: 'GET',
                    mode: 'cors'
                });

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }

                const result = await response.json();

                if (result.error) {
                    throw new Error(result.error);
                }

                // Success
                testResult.className = 'p-4 rounded-lg border border-green-200 bg-green-50';
                testResult.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <i class="fas fa-check-circle text-green-600 text-xl"></i>
                        <div>
                            <p class="font-semibold text-green-900">Connection Successful!</p>
                            <p class="text-sm text-green-700">Successfully connected to Google Sheets. Found ${result.data ? result.data.length : 0} rows in Staff sheet.</p>
                        </div>
                    </div>
                `;

            } catch (error) {
                console.error('Connection test failed:', error);
                testResult.className = 'p-4 rounded-lg border border-red-200 bg-red-50';
                testResult.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <i class="fas fa-times-circle text-red-600 text-xl"></i>
                        <div>
                            <p class="font-semibold text-red-900">Connection Failed</p>
                            <p class="text-sm text-red-700">${error.message}</p>
                            <p class="text-xs text-red-600 mt-2">
                                <strong>Common issues:</strong><br>
                                • Apps Script not deployed as Web App<br>
                                • Access not set to "Anyone"<br>
                                • Wrong deployment URL<br>
                                • CORS not enabled
                            </p>
                        </div>
                    </div>
                `;
            }
        }

        function saveGoogleSheetsConfig() {
            const appsScriptUrl = document.getElementById('appsScriptUrl').value.trim();
            
            if (!appsScriptUrl) {
                alert('⚠️ Please enter the Apps Script deployment URL');
                return;
            }

            if (appsScriptUrl.includes('YOUR_DEPLOYMENT_ID')) {
                alert('⚠️ Please replace YOUR_DEPLOYMENT_ID with your actual deployment ID');
                return;
            }

            // Save to localStorage
            localStorage.setItem('APPS_SCRIPT_URL', appsScriptUrl);

            // Show success
            alert('✅ Configuration Saved Successfully!\n\n' +
                  'Apps Script URL has been saved.\n\n' +
                  'The Umair Staff Portal will now use this configuration.\n\n' +
                  'Next steps:\n' +
                  '1. Open Umair Portal\n' +
                  '2. Test login with staff credentials\n' +
                  '3. Verify data sync is working');

            // Update status and close
            updateConfigStatus();
            
            // Close modal after a brief delay
            setTimeout(() => {
                closeGoogleSheetsConfig();
            }, 500);
        }

        function showComingSoon(integration) {
            alert(`🚧 ${integration} Integration\n\n` +
                  `${integration} integration is coming soon!\n\n` +
                  `This feature is currently under development.\n\n` +
                  `For now, only Google Sheets integration is available.`);
        }

        function showSetupGuide() {
            const guideWindow = window.open('', '_blank');
            guideWindow.document.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>Google Sheets Integration Setup Guide</title>
                    <style>
                        body { font-family: system-ui, -apple-system, sans-serif; max-width: 800px; margin: 40px auto; padding: 20px; line-height: 1.6; }
                        h1 { color: #1e40af; }
                        h2 { color: #3b82f6; margin-top: 30px; }
                        code { background: #f3f4f6; padding: 2px 6px; border-radius: 3px; font-size: 14px; }
                        pre { background: #1f2937; color: #f9fafb; padding: 15px; border-radius: 8px; overflow-x: auto; }
                        .step { background: #eff6ff; padding: 15px; border-left: 4px solid #3b82f6; margin: 20px 0; }
                        .warning { background: #fef3c7; padding: 15px; border-left: 4px solid #f59e0b; margin: 20px 0; }
                        a { color: #2563eb; text-decoration: none; }
                        a:hover { text-decoration: underline; }
                    </style>
                </head>
                <body>
                    <h1>🔗 Google Sheets Integration Setup Guide</h1>
                    
                    <p><strong>Source Sheet:</strong> <a href="https://docs.google.com/spreadsheets/d/1bTBIXZAlK0Z-EgIxAOWviY_-oETih07KtMOWgFmL9ew/edit" target="_blank">Open Google Sheet</a></p>
                    
                    <h2>Step 1: Open Apps Script Editor</h2>
                    <div class="step">
                        <ol>
                            <li>Open the Google Sheet</li>
                            <li>Click <strong>Extensions</strong> → <strong>Apps Script</strong></li>
                            <li>Delete any existing code in the editor</li>
                        </ol>
                    </div>

                    <h2>Step 2: Copy Apps Script Code</h2>
                    <div class="step">
                        <p>The Apps Script code is available in:</p>
                        <code>/home/user/webapp/GOOGLE_APPS_SCRIPT_SETUP.md</code>
                        <p style="margin-top: 10px;">Copy the entire code block (starting from <code>/**</code> to the end)</p>
                    </div>

                    <h2>Step 3: Deploy as Web App</h2>
                    <div class="step">
                        <ol>
                            <li>Click <strong>Deploy</strong> → <strong>New deployment</strong></li>
                            <li>Click gear icon ⚙️ → Select <strong>Web app</strong></li>
                            <li>Set <strong>Execute as:</strong> Me</li>
                            <li>Set <strong>Who has access:</strong> Anyone</li>
                            <li>Click <strong>Deploy</strong></li>
                            <li><strong>Copy the Web app URL</strong> (starts with https://script.google.com/macros/s/...)</li>
                        </ol>
                    </div>

                    <div class="warning">
                        <strong>⚠️ Important:</strong> Make sure to set access to "Anyone" otherwise the portal won't be able to connect due to CORS restrictions.
                    </div>

                    <h2>Step 4: Configure Portal</h2>
                    <div class="step">
                        <ol>
                            <li>Return to System Settings → System Config</li>
                            <li>Click <strong>Configure</strong> under Google Sheets Integration</li>
                            <li>Paste the Web app URL</li>
                            <li>Click <strong>Test Connection</strong></li>
                            <li>If successful, click <strong>Save Configuration</strong></li>
                        </ol>
                    </div>

                    <h2>Step 5: Verify Sheet Structure</h2>
                    <div class="step">
                        <p>Ensure your Google Sheet has these tabs with correct columns:</p>
                        <ul>
                            <li><strong>Staff:</strong> StaffID, Name, Email, Role, Status, Department</li>
                            <li><strong>Attendance:</strong> StaffID, StaffName, Date, TimeIn, TimeOut, WorkMode, Location, Latitude, Longitude, Notes</li>
                            <li><strong>Applications:</strong> ApplicationID, StudentName, Course, University, Intake, Country, Source, PartnerName, Status, ReceivedDate, SubmittedDate, CaseStatus, Handler</li>
                            <li><strong>Offers:</strong> OfferID, ApplicationID, StudentName, OfferStatus, Conditions, OfferDate, University, Country, Intake, ActionTaken, Handler</li>
                        </ul>
                    </div>

                    <h2>Step 6: Test Portal</h2>
                    <div class="step">
                        <ol>
                            <li>Open <a href="https://3000-i1or73f6i7zoopcazy4yn-2b54fc91.sandbox.novita.ai/umair-portal" target="_blank">Umair Staff Portal</a></li>
                            <li>Add Umair to the Staff sheet if not already there</li>
                            <li>Login with Umair's email</li>
                            <li>Test all features (Dashboard, Attendance, Applications, Daily Report)</li>
                        </ol>
                    </div>

                    <h2>Troubleshooting</h2>
                    <div class="warning">
                        <p><strong>Connection Failed?</strong></p>
                        <ul>
                            <li>Verify Apps Script is deployed as Web App</li>
                            <li>Check that access is set to "Anyone"</li>
                            <li>Ensure deployment URL is correct</li>
                            <li>Test in Apps Script editor (Executions tab)</li>
                        </ul>
                    </div>

                    <p style="margin-top: 40px; text-align: center; color: #6b7280;">
                        <strong>Need more help?</strong> Check the full documentation at<br>
                        <code>/home/user/webapp/UMAIR_PORTAL_SUMMARY.md</code>
                    </p>
                </body>
                </html>
            `);
        }
    </script>
</body>
</html>
