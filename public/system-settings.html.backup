                                <label class="block text-sm font-medium text-gray-700 mb-2">Database Type</label>
                                <input type="text" value="${SYSTEM_SETTINGS.system.database}" readonly class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50" disabled>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Storage Provider</label>
                                <input type="text" value="${SYSTEM_SETTINGS.system.storage}" readonly class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50" disabled>
                            </div>
                        </div>
                    </div>

                    <!-- Integration Settings -->
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <h3 class="text-lg font-semibold text-gray-800 mb-6">External Integrations</h3>
                        <div class="space-y-4">
