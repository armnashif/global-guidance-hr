        function createBackup() {
            const confirmed = confirm('Create Manual Backup?\n\nThis will create a full backup of all system data.\nEstimated size: ~250 MB\nTime: ~2 minutes\n\nProceed?');
            if (confirmed) {
                // Show loading indicator
                const originalText = event.target.innerHTML;
                event.target.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Creating Backup...';
                event.target.disabled = true;
                
                // Simulate backup creation
                setTimeout(() => {
                    // Create backup data
                    const backupData = {
                        timestamp: new Date().toISOString(),
                        settings: localStorage.getItem('gghr_fresh_documents') || '[]',
                        employees: localStorage.getItem('gghr_fresh_employees') || '[]',
                        attendance: localStorage.getItem('gghr_fresh_attendanceData') || '[]',
                        leaves: localStorage.getItem('gghr_fresh_leaveRequests') || '[]',
                        messages: localStorage.getItem('gghr_fresh_messages') || '[]',
                        emails: localStorage.getItem('gghr_fresh_emails') || '[]'
                    };
                    
                    // Convert to JSON and create download
                    const dataStr = JSON.stringify(backupData, null, 2);
                    const dataBlob = new Blob([dataStr], { type: 'application/json' });
                    const url = URL.createObjectURL(dataBlob);
                    const link = document.createElement('a');
                    link.href = url;
                    link.download = `global-guidance-backup-${new Date().toISOString().split('T')[0]}.json`;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(url);
                    
                    event.target.innerHTML = originalText;
                    event.target.disabled = false;
                    alert('✅ Backup Created Successfully!\n\nThe backup file has been downloaded to your computer.\n\nFilename: global-guidance-backup-' + new Date().toISOString().split('T')[0] + '.json');
                }, 1500);
            }
        }

        function openRestoreModal() {
            alert('Restore Data Modal\n\nSelect a backup to restore:\n\n1. 2026-02-08 01:00 AM (245 MB)\n2. 2026-02-07 01:00 AM (242 MB)\n3. 2026-02-06 01:00 AM (238 MB)\n\nWarning: This will overwrite current data!');
        }

        function performCleanup() {
            const confirmed = confirm('System Cleanup?\n\nThis will:\n- Clear cache and temporary files\n- Remove old log files\n- Optimize database\n\nEstimated space to be freed: ~150 MB\n\nProceed?');
            if (confirmed) {
                alert('Cleanup Started!\n\nCleaning up system...\nThis may take a few minutes.');
